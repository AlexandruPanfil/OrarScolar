@page "/orar/general"
@inject IDbContextFactory<AppDb> Factory

<PageTitle>Orarul general</PageTitle>
<h1>Orar</h1>

@if (rows == null)
{
    <p>Nu există un orar generat.</p>
}
else
{
    <ul class="nav nav-tabs mb-3 no-print">
        @foreach (var t in new[] { Tip.Clasa, Tip.Profesor, Tip.Sala })
        {
            <li class="nav-item"><a class="nav-link" href="orar?tip=@OrarView.TipParam(t)">@OrarView.TipLabel(t)</a></li>
        }
        <li class="nav-item"><a class="nav-link active" href="orar/general">Toate clasele</a></li>
    </ul>

    <div class="d-flex flex-wrap gap-2 mb-3 no-print">
        <a class="btn btn-outline-secondary" href="export/pdf-general" download data-enhance-nav="false">PDF (A3, pentru avizier)</a>
        <a class="btn btn-outline-secondary" href="export/excel" download data-enhance-nav="false">Excel (tot orarul)</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Tipărește</button>
    </div>

    <h2 class="h4">Orarul general al școlii</h2>
    <p class="text-muted small no-print">Fiecare celulă: materia, profesorul, sala. Țineți mouse-ul pe o celulă pentru denumirile complete.</p>

    <div class="orar-general-wrap">
        <table class="table table-bordered table-sm orar-general">
            <thead>
                <tr>
                    <th rowspan="2" class="cls">Clasa</th>
                    @foreach (var d in Slots.DayNames) { <th colspan="@Slots.Periods" class="day-start text-center">@d</th> }
                </tr>
                <tr>
                    @for (int s = 0; s < Slots.Count; s++)
                    {
                        <th class="text-center @(s % Slots.Periods == 0 ? "day-start" : "")" title="@BellSchedule.Current.Label(s % Slots.Periods)">@(s % Slots.Periods + 1)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr>
                        <th class="cls">@r.ClassName</th>
                        @for (int s = 0; s < Slots.Count; s++)
                        {
                            var c = r.Cells[s];
                            <td class="@(s % Slots.Periods == 0 ? "day-start" : "")" title="@(c?.Full)">
                                @if (c != null)
                                {
                                    <div class="fw-semibold">@c.Subject</div>
                                    <div class="text-muted">@c.Teacher</div>
                                    <div class="text-muted">@c.Room</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    List<GeneralRow>? rows;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        rows = (await OrarView.LoadAsync(db))?.General();
    }
}

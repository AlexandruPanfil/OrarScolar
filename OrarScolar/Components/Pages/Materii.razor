@page "/materii"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDb> Factory

<PageTitle>Materii</PageTitle>
<h1>Materii</h1>

<SaveStatus Error="@error" Invalidated="@invalidated" />

<EditForm Model="form" OnValidSubmit="SaveAsync" FormName="materie" class="row g-2 align-items-end mb-3">
    <DataAnnotationsValidator />
    <div class="col-auto"><label class="form-label">Nume</label><InputText class="form-control" @bind-Value="form.Name" /></div>
    <div class="col-auto">
        <label class="form-label">Tip sală</label>
        <InputSelect class="form-select" @bind-Value="form.RoomType">
            @foreach (var t in Enum.GetValues<RoomType>()) { <option value="@t">@t.Ro()</option> }
        </InputSelect>
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <InputCheckbox class="form-check-input" id="dificila" @bind-Value="form.IsDifficult" />
        <label class="form-check-label" for="dificila">Dificilă</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">@(form.Id == 0 ? "Adaugă" : "Salvează")</button>
        @if (form.Id != 0) { <button type="button" class="btn btn-secondary ms-1" @onclick="New">Renunță</button> }
    </div>
    <ValidationSummary class="col-12" />
</EditForm>

<table class="table table-sm">
    <thead><tr><th>Nume</th><th>Tip sală</th><th>Dificilă</th><th></th></tr></thead>
    <tbody>
        @foreach (var s in items)
        {
            <tr>
                <td>@s.Name</td><td>@s.RoomType.Ro()</td><td>@(s.IsDifficult ? "da" : "")</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(s)">Editează</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(s.Id)">Șterge</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    List<Subject> items = [];
    Subject form = new();
    string? error;
    bool invalidated;

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        items = await db.Subjects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    void New() => form = new();
    void Edit(Subject s) => form = new() { Id = s.Id, Name = s.Name, RoomType = s.RoomType, IsDifficult = s.IsDifficult };

    async Task SaveAsync()
    {
        await using var db = await Factory.CreateDbContextAsync();
        (error, invalidated) = await db.UpsertAsync(form.Id, form);
        if (error == null) { New(); await LoadAsync(); }
    }

    async Task DeleteAsync(int id)
    {
        await using var db = await Factory.CreateDbContextAsync();
        (error, invalidated) = await db.DeleteAsync<Subject>(id);
        await LoadAsync();
    }
}
